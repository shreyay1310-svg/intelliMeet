# IntellMeet Client Environment Configuration

# In local development, you can leave this empty because Vite proxies /api and /socket.io to http://localhost:5000.
# In production (e.g., deployed on Vercel/Netlify), set this to your deployed backend URL:
# Example: VITE_API_URL=https://intellimeet-api.onrender.com
VITE_API_URL=

# Socket URL (Optional: Defaults to VITE_API_URL or current host)
# Example: VITE_SOCKET_URL=https://intellimeet-api.onrender.com
VITE_SOCKET_URL=
