# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database
# If MONGO_URI is omitted or cannot be reached locally, an embedded MongoDB Memory Server will automatically spin up!
MONGO_URI=mongodb://127.0.0.1:27017/intellimeet

# Authentication
JWT_SECRET=super_secret_intellimeet_jwt_key_2026_dev
JWT_EXPIRES_IN=7d

# AI Intelligence (OpenAI or compatible API)
# If no key is set, the system uses an intelligent internal synthesizer for summaries and action items.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cloud Storage (Optional for recordings and profile uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
